# Server
NODE_ENV=development
PORT=3000
APP_NAME=SkilledSA
API_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://skilledsa_user:devpassword@localhost:5432/skilledsa_dev
REDIS_URL=redis://localhost:6379

# JWT RSA Keys (paths to PEM files)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# AWS S3 (MinIO or AWS)
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=skilledsa-dev
S3_PRESIGNED_URL_EXPIRY=60

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=no-reply@skilledsa.local

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100

# Feature flags
FEATURE_REFERRALS=true