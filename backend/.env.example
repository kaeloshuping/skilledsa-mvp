NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://skilledsa_user:devpassword@localhost:5432/skilledsa_dev
REDIS_URL=redis://localhost:6379

# Stripe/PayFast - we'll mock payments, so these are placeholders
PAYFAST_MERCHANT_ID=sandbox_merchant
PAYFAST_MERCHANT_KEY=sandbox_key
PAYFAST_PASSPHRASE=sandbox_passphrase
PAYFAST_SANDBOX=true

# Google Maps - we'll use a dummy key for now
GOOGLE_MAPS_API_KEY=dummy_key

# SendGrid - we'll mock email sending
SENDGRID_API_KEY=dummy_key
SENDGRID_FROM_EMAIL=no-reply@skilledsa.local

# Twilio - mock SMS
TWILIO_ACCOUNT_SID=dummy_sid
TWILIO_AUTH_TOKEN=dummy_token
TWILIO_PHONE_NUMBER=+1234567890

# Feature flags
FEATURE_REFERRALS=true