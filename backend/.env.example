# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000
APP_NAME=SkilledSA
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://skilledsa_user:devpassword@localhost:5432/skilledsa_dev

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JWT (RS256) – generate with: openssl genrsa -out private.pem 2048
#                                openssl rsa -in private.pem -pubout -out public.pem
# ============================================
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----

# ============================================
# AWS S3 (for file uploads)
# ============================================
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=skilledsa-uploads
S3_PRESIGNED_URL_EXPIRY=60    # seconds

# ============================================
# Email (SendGrid)
# ============================================
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@skilledsa.co.za

# ============================================
# SMS (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+27871234567

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
LOG_FILE_PATH=/var/log/skilledsa

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
RATE_LIMIT_MAX_REQUESTS=5      # login attempts
RATE_LIMIT_GENERAL_WINDOW_MS=60000   # 1 minute
RATE_LIMIT_GENERAL_MAX=100     # API requests per minute

# ============================================
# Feature Flags
# ============================================
FEATURE_REFERRALS=false