generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  customer
  contractor
  admin
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum EscrowStatus {
  created
  held
  released
  refunded
}

enum JobStatus {
  draft
  open
  quoted
  accepted
  milestone1_pending
  milestone1_verified
  milestone2_pending
  completed
  disputed
  cancelled
}

// ============================================
// MODELS
// ============================================

model User {
  id                      String              @id @default(uuid())
  email                   String              @unique
  password_hash           String
  role                    Role                @default(customer)
  full_name               String
  phone                   String?
  is_active               Boolean             @default(true)
  last_login              DateTime?
  verification_status     VerificationStatus  @default(pending)
  notification_preference Json?
  popia_consent           Boolean             @default(false)
  data_retention_date     DateTime?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  jobs_as_customer        Job[]                      @relation("CustomerJobs")
  jobs_as_contractor      Job[]                      @relation("ContractorJobs")
  admin_logs              AdminLog[]                 @relation("AdminLogs")
  verification_request    VerificationRequest?       @relation("userVerification")
  reviewed_verifications  VerificationRequest[]      @relation("reviewedBy")
  refresh_tokens          RefreshToken[]
  file_uploads            FileUpload[]

  @@index([email])
  @@index([role])
  @@index([verification_status])
}

model VerificationRequest {
  id               String            @id @default(uuid())
  user_id          String            @unique
  user             User              @relation("userVerification", fields: [user_id], references: [id])
  role             Role
  id_photo_url     String
  selfie_url       String
  certificate_url  String?
  status           VerificationStatus @default(pending)
  admin_notes      String?
  admin_id         String?
  admin            User?             @relation("reviewedBy", fields: [admin_id], references: [id])
  reviewed_at      DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  @@index([status])
  @@index([created_at])
}

model RefreshToken {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  token_hash  String   @unique
  expires_at  DateTime
  revoked     Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
}

model FileUpload {
  id          String   @id @default(uuid())
  url         String
  key         String
  bucket      String
  size        Int
  mime_type   String
  uploaded_by String
  user        User     @relation(fields: [uploaded_by], references: [id])
  created_at  DateTime @default(now())
  expires_at  DateTime

  @@index([uploaded_by])
  @@index([expires_at])
}

model EscrowTransaction {
  id                    String          @id @default(uuid())
  job_id                String          @unique
  stripe_payment_intent_id String?
  stripe_transfer_id    String?
  idempotency_key       String?         @unique
  amount_total          Decimal?        @db.Decimal(10,2)
  amount_contractor     Decimal?        @db.Decimal(10,2)
  amount_platform       Decimal?        @db.Decimal(10,2)
  status                EscrowStatus    @default(created)
  admin_clawback_rever  Boolean?
  created_at            DateTime        @default(now())

  job                   Job             @relation(fields: [job_id], references: [id])

  @@index([job_id])
}

model Job {
  id                    String          @id @default(uuid())
  customer_id           String
  contractor_id         String?
  status                JobStatus       @default(draft)
  location              String?         // WKT string e.g. "POINT(28.0473 -26.2041)"
  travel_fee            Decimal?        @db.Decimal(10,2)
  total_value           Decimal?        @db.Decimal(10,2)

  // --- NEW FIELDS (added for job creation) ---
  title                 String          @db.VarChar(255)
  description           String          @db.Text
  trade                 String          @db.VarChar(100)
  photos                Json?           // array of photo URLs
  locationLat           Float?          // latitude for quick access
  locationLng           Float?          // longitude for quick access
  needsConsultation     Boolean         @default(false)
  travelFeeAccepted     Boolean         @default(false)
  // -----------------------------------------

  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  customer              User            @relation("CustomerJobs", fields: [customer_id], references: [id])
  contractor            User?           @relation("ContractorJobs", fields: [contractor_id], references: [id])
  escrow_transaction    EscrowTransaction?

  @@index([status])
  @@index([trade])
  @@index([locationLat, locationLng])
  // GIST index for location is created via raw SQL in migration
}

model AdminLog {
  id                    String          @id @default(uuid())
  request_id            String          @db.Uuid
  admin_id              String
  action                String
  target_type           String
  target_id             String
  before_state          Json?
  after_state           Json?
  ip_address            String?
  user_agent            String?
  created_at            DateTime        @default(now())

  admin                 User            @relation("AdminLogs", fields: [admin_id], references: [id])

  @@index([admin_id])
  // BRIN index on created_at is added via raw SQL migration
}