generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

/** User roles in the system */
enum Role {
  customer
  contractor
  admin
}

/** Verification status for user identities and documents */
enum VerificationStatus {
  pending
  verified
  rejected
}

/** Lifecycle of an escrow transaction */
enum EscrowStatus {
  created
  held
  released
  refunded
}

/** State machine for a job’s progress */
enum JobStatus {
  draft
  open
  quoted
  accepted
  milestone1_pending
  milestone1_verified
  milestone2_pending
  completed
  disputed
  cancelled
}

// ============================================
// MODELS
// ============================================

/**
 * User – core account data.
 * All fields follow snake_case to match PostgreSQL naming conventions.
 */
model User {
  id                      String              @id @default(uuid())
  email                   String              @unique
  password_hash           String              // bcrypt hash, never stored in plaintext
  role                    Role                @default(customer)
  full_name               String
  phone                   String?
  is_active               Boolean             @default(true)
  last_login              DateTime?
  verification_status     VerificationStatus  @default(pending)
  notification_preference Json?               // JSONB, stores email/SMS/push preferences
  popia_consent           Boolean             @default(false)
  data_retention_date     DateTime?           // 90 days after account closure
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  // Relations
  jobs_as_customer        Job[]                      @relation("CustomerJobs")
  jobs_as_contractor      Job[]                      @relation("ContractorJobs")
  admin_logs              AdminLog[]                 @relation("AdminLogs")
  verification_request    VerificationRequest?       @relation("userVerification")
  reviewed_verifications  VerificationRequest[]      @relation("reviewedBy")
  refresh_tokens          RefreshToken[]
  file_uploads            FileUpload[]

  @@index([email])
  @@index([role])
  @@index([verification_status])
}

/**
 * VerificationRequest – holds documents and admin review status.
 * One‑to‑one with User (a user has one request).
 */
model VerificationRequest {
  id               String            @id @default(uuid())
  user_id          String            @unique
  user             User              @relation("userVerification", fields: [user_id], references: [id])
  role             Role              // Role being verified (customer/contractor)
  id_photo_url     String            // S3 URL of ID document
  selfie_url       String            // S3 URL of selfie photo
  certificate_url  String?           // Optional, for contractors (trade certificates)
  status           VerificationStatus @default(pending)
  admin_notes      String?
  admin_id         String?           // Admin who reviewed this request
  admin            User?             @relation("reviewedBy", fields: [admin_id], references: [id])
  reviewed_at      DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  @@index([status])
  @@index([created_at])
}

/**
 * RefreshToken – stores JWT refresh tokens (hashed) for rotation.
 */
model RefreshToken {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  token_hash  String   @unique        // SHA‑256 of the raw token
  expires_at  DateTime
  revoked     Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
}

/**
 * FileUpload – tracks files stored in S3 (or MinIO locally).
 * Used for all uploads: photos, documents, etc.
 */
model FileUpload {
  id          String   @id @default(uuid())
  url         String   // Publicly accessible URL (presigned or CDN)
  key         String   // S3 object key
  bucket      String
  size        Int      // File size in bytes
  mime_type   String
  uploaded_by String   // User ID who uploaded
  user        User     @relation(fields: [uploaded_by], references: [id])
  created_at  DateTime @default(now())
  expires_at  DateTime // For temporary/expiring files

  @@index([uploaded_by])
  @@index([expires_at])
}

/**
 * EscrowTransaction – holds payment data for a job.
 * One‑to‑one with Job.
 */
model EscrowTransaction {
  id                    String          @id @default(uuid())
  job_id                String          @unique
  stripe_payment_intent_id String?      // Stripe PaymentIntent ID
  stripe_transfer_id    String?         // Stripe transfer ID (if applicable)
  idempotency_key       String?         @unique // Prevents duplicate Stripe calls
  amount_total          Decimal?        @db.Decimal(10,2)
  amount_contractor     Decimal?        @db.Decimal(10,2)
  amount_platform       Decimal?        @db.Decimal(10,2)
  status                EscrowStatus    @default(created)
  admin_clawback_rever  Boolean?        // Tracks admin‑initiated clawback
  created_at            DateTime        @default(now())

  job                   Job             @relation(fields: [job_id], references: [id])

  @@index([job_id])
}

/**
 * Job – the core listing, with geospatial location.
 * location is stored as a PostGIS geography(Point,4326) – see migration SQL.
 */
model Job {
  id                    String          @id @default(uuid())
  customer_id           String
  contractor_id         String?
  status                JobStatus       @default(draft)
  location              String?         // WKT string, e.g. "POINT(28.0473 -26.2041)"
  travel_fee            Decimal?        @db.Decimal(10,2)
  total_value           Decimal?        @db.Decimal(10,2)
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  customer              User            @relation("CustomerJobs", fields: [customer_id], references: [id])
  contractor            User?           @relation("ContractorJobs", fields: [contractor_id], references: [id])
  escrow_transaction    EscrowTransaction?

  @@index([status])
  // GIST index for location is created via raw SQL in migration
}

/**
 * AdminLog – audit trail for all admin actions.
 * Uses BRIN index on created_at for efficiency (see migration).
 */
model AdminLog {
  id                    String          @id @default(uuid())
  request_id            String          @db.Uuid // X‑Request‑ID from middleware
  admin_id              String
  action                String          // e.g. "APPROVE_VERIFICATION"
  target_type           String          // e.g. "user", "verification_request"
  target_id             String          // ID of the target entity
  before_state          Json?           // Snapshot before change
  after_state           Json?           // Snapshot after change
  ip_address            String?
  user_agent            String?
  created_at            DateTime        @default(now())

  admin                 User            @relation("AdminLogs", fields: [admin_id], references: [id])

  @@index([admin_id])
  // BRIN index on created_at is added via raw SQL migration
}