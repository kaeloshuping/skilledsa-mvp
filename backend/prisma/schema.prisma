generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  contractor
  admin
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum EscrowStatus {
  created
  held
  released
  refunded
}

enum JobStatus {
  draft
  open
  quoted
  accepted
  active
  completed
  cancelled
}

model User {
  id                      String              @id @default(uuid())
  email                   String              @unique
  password_hash           String
  role                    Role                @default(customer)
  full_name               String
  phone                   String?
  is_active               Boolean             @default(true)
  last_login              DateTime?
  verification_status     VerificationStatus  @default(pending)
  notification_preference Json?
  popia_consent           Boolean             @default(false)
  data_retention_date     DateTime?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  jobs_as_customer        Job[]               @relation("CustomerJobs")
  quotes                  Quote[]
  admin_logs              AdminLog[]          @relation("AdminLogs")
  verification_request    VerificationRequest? @relation("userVerification")
  reviewed_verifications  VerificationRequest[] @relation("reviewedBy")
  refresh_tokens          RefreshToken[]
  file_uploads            FileUpload[]

  @@index([email])
  @@index([role])
  @@index([verification_status])
}

model VerificationRequest {
  id               String            @id @default(uuid())
  user_id          String            @unique
  user             User              @relation("userVerification", fields: [user_id], references: [id])
  role             Role
  id_photo_url     String
  selfie_url       String
  certificate_url  String?
  status           VerificationStatus @default(pending)
  admin_notes      String?
  admin_id         String?
  admin            User?             @relation("reviewedBy", fields: [admin_id], references: [id])
  reviewed_at      DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  @@index([status])
  @@index([created_at])
}

model RefreshToken {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  token_hash  String   @unique
  expires_at  DateTime
  revoked     Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
}

model FileUpload {
  id          String   @id @default(uuid())
  url         String
  key         String
  bucket      String
  size        Int
  mime_type   String
  uploaded_by String
  user        User     @relation(fields: [uploaded_by], references: [id])
  created_at  DateTime @default(now())
  expires_at  DateTime

  @@index([uploaded_by])
  @@index([expires_at])
}

model EscrowTransaction {
  id                    String          @id @default(uuid())
  job_id                String          @unique
  stripe_payment_intent_id String?
  stripe_transfer_id    String?
  idempotency_key       String?         @unique
  amount_total          Decimal?        @db.Decimal(10,2)
  amount_contractor     Decimal?        @db.Decimal(10,2)
  amount_platform       Decimal?        @db.Decimal(10,2)
  status                EscrowStatus    @default(created)
  admin_clawback_rever  Boolean?
  created_at            DateTime        @default(now())

  job                   Job             @relation(fields: [job_id], references: [id])

  @@index([job_id])
}

model Job {
  id                  String           @id @default(uuid())
  customerId          String
  customer            User             @relation("CustomerJobs", fields: [customerId], references: [id])
  title               String
  description         String
  trade               String
  photos              String[]
  location            Unsupported("geography(Point, 4326)")?
  locationLat         Float?
  locationLng         Float?
  needsConsultation   Boolean          @default(false)
  travelFeeAccepted   Boolean          @default(true)
  status              JobStatus        @default(open)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  quotes              Quote[]
  escrow_transaction  EscrowTransaction?

  @@index([customerId])
  @@index([trade])
  @@index([status])
}

model Quote {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id])
  contractorId  String
  contractor    User     @relation(fields: [contractorId], references: [id])
  price         Float
  timeline      Int
  travelFee     Float?
  totalPrice    Float
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([jobId])
  @@index([contractorId])
}

model AdminLog {
  id                    String          @id @default(uuid())
  request_id            String          @db.Uuid
  admin_id              String
  action                String
  target_type           String
  target_id             String
  before_state          Json?
  after_state           Json?
  ip_address            String?
  user_agent            String?
  created_at            DateTime        @default(now())

  admin                 User            @relation("AdminLogs", fields: [admin_id], references: [id])

  @@index([admin_id])
}